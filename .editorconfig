root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[legacy/**]
# AgroBot 1.0, frozen (ADR-0008). Its formatting is not ours to change.
indent_style = unset
indent_size = unset
