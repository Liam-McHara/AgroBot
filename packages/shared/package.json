{
  "name": "@agrobot/shared",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/*.json": "./src/messages/*.json"
  },
  "files": [
    "dist",
    "src/messages"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "@types/node": "^22.18.0"
  }
}
