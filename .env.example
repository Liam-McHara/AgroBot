# AgroBot 2.0 configuration — every variable of docs/architecture.md §13.
# Copy to `.env` and fill it in: `cp .env.example .env`. `.env` is git-ignored (ARCH §17).
#
# One file, three readers (ARCH §14): `wrangler dev` takes it as the Worker's variables
# (`pnpm dev` passes `--env-file`), Vite reads the `VITE_*` keys, and the CLI scripts
# (`db:migrate`, `db:seed`, `dev:telegram`, `bot:set-webhook`) read it with Node.
# Production never reads this file: vars live in `apps/server/wrangler.jsonc`, secrets are set
# with `wrangler secret put` (ADR-0016).

# ── Telegram ──────────────────────────────────────────────────────────────────────────────
# ADR-0013: production reuses AgroBot 1.0's token, and 1.0 must be stopped before 2.0 uses it
# — one token can have exactly one consumer. For development, create a throwaway bot with
# @BotFather and use its token here. Never the group's token: `pnpm dev:telegram` deletes the
# bot's webhook to long-poll it.
BOT_TOKEN=123456:replace-me
BOT_USERNAME=AgroBotDevBot
MINIAPP_SHORT_NAME=app

# The base URL of the Worker. The webhook is PUBLIC_URL/telegram/webhook and the realtime
# socket only accepts this origin (plus localhost outside production). Locally it is
# `wrangler dev`; to open the Mini App inside Telegram, point it at a tunnel
# (`cloudflared tunnel --url http://localhost:8080`) and run `pnpm bot:set-webhook`.
PUBLIC_URL=http://localhost:8080
# At least 32 random characters, e.g. `openssl rand -hex 32`. The forwarder and the Worker
# must agree on it, which they do by reading this same file.
TELEGRAM_WEBHOOK_SECRET=replace-me-with-at-least-32-random-characters

# ── Database ──────────────────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Used by the CLI scripts (migrate, seed, generate) and by
# `pnpm dev` as the local Hyperdrive target of `wrangler dev`. In production the Worker
# reaches Neon through the Hyperdrive binding instead (ARCH §13, ADR-0016); never a Worker var.
DATABASE_URL=postgres://agrobot:agrobot@localhost:5432/agrobot

# Used by the integration tests (`pnpm test`) and the e2e suite; created by docker-compose.yml.
TEST_DATABASE_URL=postgres://agrobot:agrobot@localhost:5432/agrobot_test

# ── Membership ────────────────────────────────────────────────────────────────────────────
# Comma-separated Telegram ids, approved as admins the moment they press /start (PRD §2).
# Find yours by messaging @userinfobot.
ADMIN_TELEGRAM_IDS=

# ── Catalogue (PRD §6, ARCH §10) ──────────────────────────────────────────────────────────
# `sheets` reads the group's Google Sheet through a service account; `csv` reads a
# "publish to web → CSV" URL, which makes the sheet readable by anyone holding that URL.
CATALOG_SOURCE=csv

# CATALOG_SOURCE=sheets
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_RANGE=Productes!A:E
# Base64 of the service account key file; share the sheet read-only with that account's email.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# CATALOG_SOURCE=csv
CATALOG_CSV_URL=https://docs.google.com/spreadsheets/d/e/replace-me/pub?gid=0&single=true&output=csv

# ── Runtime ───────────────────────────────────────────────────────────────────────────────
# `development` here; `production` on the Worker (wrangler.jsonc); `test` in the suites.
NODE_ENV=development
LOG_LEVEL=info
DEFAULT_LOCALE=ca
TZ=Europe/Madrid

# Optional error tracking (PRD §12 Observability).
# SENTRY_DSN=

# ── Development only ──────────────────────────────────────────────────────────────────────
# Signs the Mini App in as this Telegram id when it is opened outside Telegram (ARCH §4).
# `env.ts` refuses this variable when NODE_ENV=production. 900000001 is the seeded dev member.
DEV_AUTH_BYPASS_TELEGRAM_ID=900000001
# The id the Mini App signs in as when opened at http://localhost:5173 instead of in Telegram.
# Switch member inside the browser with `localStorage.setItem('agrobot.devTelegramId', '…')`.
VITE_DEV_TELEGRAM_ID=900000001
