# AgroBot 2.0 configuration — every variable of docs/architecture.md §13.
# Copy to `.env` and fill it in: `cp .env.example .env`. `.env` is git-ignored (ARCH §17).

# ── Telegram ──────────────────────────────────────────────────────────────────────────────
# ADR-0013: production reuses AgroBot 1.0's token, and 1.0 must be stopped before 2.0 uses it
# — one token can have exactly one consumer. For development, create a throwaway bot with
# @BotFather and use its token here. Never the group's token.
BOT_TOKEN=123456:replace-me
BOT_USERNAME=AgroBotDevBot
MINIAPP_SHORT_NAME=app

# `polling` for local development, `webhook` in production (ARCH §13). Removed in roadmap
# M2.5: the Worker is webhook-only and `scripts/dev-telegram.mjs` feeds the local webhook.
BOT_MODE=polling

# Required in webhook mode: the HTTPS base URL. The webhook is PUBLIC_URL/telegram/webhook.
# In production this is the Worker's URL (ADR-0016), e.g. https://agrobot.<account>.workers.dev
# PUBLIC_URL=
# Required in webhook mode: at least 32 random characters, e.g. `openssl rand -hex 32`.
# TELEGRAM_WEBHOOK_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Used by the CLI scripts (migrate, seed, generate) and, from M2.5,
# by `wrangler dev` as its local Hyperdrive target. In production the Worker reaches Neon
# through the Hyperdrive binding instead (ARCH §13, ADR-0016); this is never a Worker var.
DATABASE_URL=postgres://agrobot:agrobot@localhost:5432/agrobot

# Used by the integration tests (`pnpm test`); created by docker-compose.yml.
TEST_DATABASE_URL=postgres://agrobot:agrobot@localhost:5432/agrobot_test

# ── Membership ────────────────────────────────────────────────────────────────────────────
# Comma-separated Telegram ids, approved as admins the moment they press /start (PRD §2).
# Find yours by messaging @userinfobot.
ADMIN_TELEGRAM_IDS=

# ── Catalogue (PRD §6, ARCH §10) ──────────────────────────────────────────────────────────
# `sheets` reads the group's Google Sheet through a service account; `csv` reads a
# "publish to web → CSV" URL, which makes the sheet readable by anyone holding that URL.
CATALOG_SOURCE=csv

# CATALOG_SOURCE=sheets
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_RANGE=Productes!A:E
# Base64 of the service account key file; share the sheet read-only with that account's email.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# CATALOG_SOURCE=csv
CATALOG_CSV_URL=https://docs.google.com/spreadsheets/d/e/replace-me/pub?gid=0&single=true&output=csv

# ── Runtime ───────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Local only; the Worker has no port (M2.5 runs `wrangler dev --port 8080`).
PORT=8080
LOG_LEVEL=info
# Anything other than JSON-on-one-line is for humans; leave false in production.
LOG_PRETTY=false
DEFAULT_LOCALE=ca
TZ=Europe/Madrid

# Optional error tracking (PRD §12 Observability).
# SENTRY_DSN=

# ── Development only ──────────────────────────────────────────────────────────────────────
# Signs the Mini App in as this Telegram id when it is opened outside Telegram (ARCH §4).
# `env.ts` refuses this variable when NODE_ENV=production. 900000001 is the seeded dev member.
DEV_AUTH_BYPASS_TELEGRAM_ID=900000001
# The id the Mini App signs in as when opened at http://localhost:5173 instead of in Telegram.
# Switch member inside the browser with `localStorage.setItem('agrobot.devTelegramId', '…')`.
VITE_DEV_TELEGRAM_ID=900000001
