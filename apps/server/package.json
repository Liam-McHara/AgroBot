{
  "name": "@agrobot/server",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@agrobot/shared": "workspace:*",
    "@grammyjs/auto-retry": "^2.0.2",
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.8",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
