/**
 * AgroBot 2.0 on Cloudflare Workers (ARCH §3, §13, §15; ADR-0016, ADR-0017).
 *
 * One Worker (Hono API, grammY webhook, the Mini App as static assets) plus one Durable
 * Object, `AgroBotHub`, for jobs and realtime, reaching Neon Postgres through Hyperdrive.
 *
 * The top-level configuration is what `wrangler dev` runs locally: no vars in here, the
 * repository `.env` supplies them (`pnpm dev` passes `--env-file`), and the Hyperdrive binding
 * points at the Docker Postgres. Deployments use the named environments below:
 * `wrangler deploy --env production` and `wrangler deploy --env staging`. Secrets are never in
 * this file: `wrangler secret put <NAME> --env <env>` for BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET,
 * GOOGLE_SERVICE_ACCOUNT_JSON (sheets mode) and SENTRY_DSN (optional).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agrobot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // node:crypto, node:buffer and friends, which the code and its libraries use (ARCH §3).
  "compatibility_flags": ["nodejs_compat"],

  // The Mini App build. Unknown paths are its hash routes, so they get index.html; the API,
  // the webhook and /health always reach the Worker first (ARCH §3).
  "assets": {
    "directory": "../miniapp/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*", "/health"],
  },

  // The one hub instance: schedule + alarm, hibernating sockets, presence, counters (ADR-0017).
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "AgroBotHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgroBotHub"] }],

  // Locally, Hyperdrive is a pass-through to Docker Postgres. `pnpm dev` and the e2e suite
  // override the target with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local",
      "localConnectionString": "postgres://agrobot:agrobot@localhost:5432/agrobot",
    },
  ],

  // ARCH §9: a liveness check that calls hub.ensureArmed() and reads only the hub's storage.
  "triggers": { "crons": ["*/15 * * * *"] },

  // Workers Logs (free: 200 000 events/day, 3 days) for the JSON lines the logger writes.
  "observability": { "enabled": true },

  // Run next to the database (Neon, aws-eu-central-1) so every query is a short round trip.
  "placement": { "mode": "targeted", "region": "aws:eu-central-1" },

  "env": {
    // First deploy target (roadmap M2.5): a throwaway bot and the Neon `staging` branch.
    "staging": {
      "name": "agrobot-staging",
      "vars": {
        "NODE_ENV": "production",
        "BOT_USERNAME": "AgroBotStagingBot",
        "MINIAPP_SHORT_NAME": "app",
        "PUBLIC_URL": "https://agrobot-staging.REPLACE_WITH_ACCOUNT.workers.dev",
        "ADMIN_TELEGRAM_IDS": "",
        "CATALOG_SOURCE": "sheets",
        "GOOGLE_SHEET_ID": "REPLACE_WITH_TEST_SHEET_ID",
        "GOOGLE_SHEET_RANGE": "Productes!A:E",
        "DEFAULT_LOCALE": "ca",
        "TZ": "Europe/Madrid",
        "LOG_LEVEL": "info",
      },
      "durable_objects": {
        "bindings": [{ "name": "HUB", "class_name": "AgroBotHub" }],
      },
      "hyperdrive": [
        // `wrangler hyperdrive create agrobot-staging --connection-string <Neon staging pooled URL>`
        { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID" },
      ],
    },

    // The group's deployment (roadmap M6): AgroBot 1.0's bot identity (ADR-0013).
    "production": {
      "name": "agrobot",
      "vars": {
        "NODE_ENV": "production",
        "BOT_USERNAME": "REPLACE_WITH_1_0_BOT_USERNAME",
        "MINIAPP_SHORT_NAME": "app",
        "PUBLIC_URL": "https://agrobot.REPLACE_WITH_ACCOUNT.workers.dev",
        "ADMIN_TELEGRAM_IDS": "",
        "CATALOG_SOURCE": "sheets",
        "GOOGLE_SHEET_ID": "REPLACE_WITH_SHEET_ID",
        "GOOGLE_SHEET_RANGE": "Productes!A:E",
        "DEFAULT_LOCALE": "ca",
        "TZ": "Europe/Madrid",
        "LOG_LEVEL": "info",
      },
      "durable_objects": {
        "bindings": [{ "name": "HUB", "class_name": "AgroBotHub" }],
      },
      "hyperdrive": [
        // `wrangler hyperdrive create agrobot-production --connection-string <Neon production pooled URL>`
        { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_PRODUCTION_HYPERDRIVE_ID" },
      ],
    },
  },
}
